{
  "name": "@dx12xyz/dsh-asar-framework",
  "version": "0.7.3",
  "type": "module",
  "license": "MIT",
  "description": "DSH 桌面版 asar 壳桥基座：在 app.asar 官方托盘代码之后插入一段属于本包的可增长区域，让 Host 插件在不重新打包归档的前提下扩展托盘、通知、窗口与运行期行为。",
  "author": "DX12xyz",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "asar",
    "tray",
    "electron",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DX12xyz/dsh-asar-framework.git"
  },
  "homepage": "https://github.com/DX12xyz/dsh-asar-framework#readme",
  "bugs": {
    "url": "https://github.com/DX12xyz/dsh-asar-framework/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "lib/**/*.js",
    "lib/**/*.ps1",
    "bridge/package.json",
    "bridge/dist/tray-bridge.js",
    "scripts/*.mjs",
    "docs",
    "README.md",
    "TECHDOC.md",
    "HISTVER.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
